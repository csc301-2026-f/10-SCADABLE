# API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Default to the local FastAPI backend for full-stack development and TA evaluation.
# Set to "true" only to use frontend mock fixtures without a running backend.
NEXT_PUBLIC_USE_MOCKS=false

# Clerk (required for real sign-in — do not commit .env.local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: allow “Go to dashboard” bypass outside next dev (never in real prod)
# ALLOW_DEV_DASHBOARD_BYPASS=true
