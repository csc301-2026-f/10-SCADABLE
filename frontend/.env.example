# API
# Local FastAPI: http://localhost:8000
# Live Railway via Next rewrite: /api/backend (see next.config.ts)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Default to the local FastAPI backend for full-stack development and TA evaluation.
# Set to "true" only to use frontend mock fixtures without a running backend.
NEXT_PUBLIC_USE_MOCKS=false

# Clerk (required for real sign-in — do not commit .env.local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: allow “Go to dashboard” bypass outside next dev (never in real prod)
# ALLOW_DEV_DASHBOARD_BYPASS=true

# Server-only (Account page gateways). Never prefix with NEXT_PUBLIC_.
# SCRAPING_SETTINGS_ADMIN_TOKEN=
# GITHUB_INTEGRATION_ADMIN_TOKEN=
# BACKEND_API_URL=https://backend-d3-production.up.railway.app
