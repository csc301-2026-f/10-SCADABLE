# Shared repository-root configuration for scraping and downstream analysis.
# Copy this file to .env in the repository root; process environment values win.
# Required for downstream analysis and for the scraper's LLM selection mode.
OPENAI_API_KEY=
# Downstream analysis model; must support Responses API structured outputs.
# The scraper's Decisions model is configured separately by the scraper package.
OPENAI_MODEL=
# Per-attempt analysis timeout; full Markdown extraction can take longer than 30s.
OPENAI_TIMEOUT_SECONDS=120
