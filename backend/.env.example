# Copy to backend/.env and fill in. Never commit .env.
DATABASE_URL=postgresql://user:password@localhost:5432/live_swot

# Comma-separated frontend origins allowed to call the API (add the Vercel URL).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Offline development only: use mock pages when the real crawl fails.
# Leave unset in production so a failed crawl fails the research run.
ALLOW_MOCK_CRAWLER=false

# Automatic competitor research refreshes. OFF by default to avoid surprise
# crawler / OpenAI charges. Enable on one or more always-on API workers.
AUTO_REFRESH_ENABLED=false
COMPETITOR_REFRESH_DAYS=7
COMPETITOR_REFRESH_RETRY_MINUTES=60
# The scheduler checks for due work every 60 seconds.
COMPETITOR_REFRESH_POLL_SECONDS=60

# GitHub App product feature synchronization (server-side only).
# Set after creating/installing a GitHub App with Contents: Read and Push events.
GITHUB_APP_ID=
# PEM, either literal newlines or \n-escaped, supplied privately on Railway.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Strong independent secret. Never expose to frontend/client-side JavaScript.
GITHUB_INTEGRATION_ADMIN_TOKEN=
# GitHub sync worker auto-starts when App ID and private key are configured.
GITHUB_SYNC_ENABLED=true
GITHUB_SYNC_POLL_SECONDS=60
# OFF by default: refreshing existing comparisons incurs LLM/API costs.
GITHUB_RECOMPARE_ON_SYNC=false

# Required for PUT /settings/scraping (set to a long random secret in Railway).
# Do not expose this token in browser code or NEXT_PUBLIC_* variables.
SCRAPING_SETTINGS_ADMIN_TOKEN=

# Optional per-account OpenAI key bridge. Set SAME random secret on Railway
# and trusted Next.js server (never NEXT_PUBLIC_*). The Next.js gateway must
# authenticate the Clerk user and read privateMetadata.openaiApiKey before
# forwarding a key. Without these headers, research uses OPENAI_API_KEY.
# Also required for POST /runs/{id}/cancel. Without it, cancelling runs is turned off.
ACCOUNT_RESEARCH_BRIDGE_TOKEN=

# Seconds each AI step may take. With reviewer retries (OPENAI_CALL_LIMIT in
# the root .env) a step can make up to 6 calls, so both default to 300.
ANALYSIS_TIMEOUT_SECONDS=300
OVERALL_SWOT_TIMEOUT_SECONDS=300

# Optional restart-safe recovery of missing/incomplete Langfuse costs.
# Only starts when Langfuse is configured; leaves the original 5-minute lookup unchanged.
LANGFUSE_COST_RECOVERY_ENABLED=true
LANGFUSE_COST_RECOVERY_POLL_SECONDS=300
