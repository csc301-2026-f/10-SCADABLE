# Copy to backend/.env and fill in. Never commit .env.
DATABASE_URL=postgresql://user:password@localhost:5432/live_swot

# Comma-separated frontend origins allowed to call the API (add the Vercel URL).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Offline development only: use mock pages when the real crawl fails.
# Leave unset in production so a failed crawl fails the research run.
ALLOW_MOCK_CRAWLER=false

# Automatic competitor research refreshes. OFF by default to avoid surprise
# crawler / OpenAI charges. Enable on one or more always-on API workers.
AUTO_REFRESH_ENABLED=false
COMPETITOR_REFRESH_DAYS=7
COMPETITOR_REFRESH_RETRY_MINUTES=60
# The scheduler checks for due work every 60 seconds.
COMPETITOR_REFRESH_POLL_SECONDS=60

# GitHub App product feature synchronization (server-side only).
# Set after creating/installing a GitHub App with Contents: Read and Push events.
GITHUB_APP_ID=
# PEM, either literal newlines or \n-escaped, supplied privately on Railway.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Strong independent secret. Never expose to frontend/client-side JavaScript.
GITHUB_INTEGRATION_ADMIN_TOKEN=
# GitHub sync worker auto-starts when App ID and private key are configured.
GITHUB_SYNC_ENABLED=true
GITHUB_SYNC_POLL_SECONDS=60
# OFF by default: refreshing existing comparisons incurs LLM/API costs.
GITHUB_RECOMPARE_ON_SYNC=false
